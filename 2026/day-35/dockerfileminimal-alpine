FROM node:18-alpine

WORKDIR /app

# Create user
RUN addgroup -S appgroup && adduser -S appuser -G appgroup && chown -R appuser:appgroup /app

# Copy files
COPY . .

# Install dependencies
RUN npm install

# Change ownership
#RUN chown -R appuser:appgroup /app

# Switch user
USER appuser

CMD ["node", "app.js"]
