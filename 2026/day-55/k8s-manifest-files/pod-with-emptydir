apiVersion: v1
kind: Pod
metadata:
  name: emptydir-demo
spec:
  containers:
  - name: writer
    image: busybox
    command: ["/bin/sh", "-c"]
    args:
      - date > /data/message.txt && sleep 3600      #writes current timestamp & keeps container running so you can exec into it
    volumeMounts:                   #inside container, Its like Attach that storage (data-volume), Inside the container at /data, OR Its like Mount that disk inside my container at /data
    - name: data-volume
      mountPath: /data
  volumes:                          #defined at Pod level
  - name: data-volume
    emptyDir: {}                    #Create a temporary storage space, It lives as long as the Pod lives, Initially empty, Its like Kubernetes, give me a scratch disk for this Pod
