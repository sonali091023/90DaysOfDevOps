# group_vars/**/vault.yml

# SSH private keys
*.pem
*.key
id_rsa
id_ed25519

# Ansible retry files
*.retry

# Python cache
__pycache__/
*.pyc

# VS Code
.vscode/

# IntelliJ/PyCharm
.idea/

# MacOS
.DS_Store

# Logs
*.log

# Terraform
.terraform/
.terraform.lock.hcl
terraform.tfstate
terraform.tfstate.*
*.tfvars

# Local inventory (only if it contains private IPs or personal data)
# inventory.ini

# ─── Ansible Vault / Secrets ──────────────────────
group_vars/all/vault.yml          # encrypted secrets
group_vars/all/secrets.yml        # any plain secrets file
.vault_pass                       # vault password file
vault_password.txt

# ─── Environment Files ────────────────────────────
.env
.env.local
.env.production
*.env

# ─── SSH Keys ─────────────────────────────────────
*.pem
*.key
id_rsa
id_rsa.pub
~/.ssh/

# ─── Inventory with real IPs ──────────────────────
inventory/hosts               # contains your server IPs/hostnames
inventory/production          # production server details

# ─── Ansible Retry Files ──────────────────────────
*.retry

# ─── Logs ─────────────────────────────────────────
*.log
logs/















